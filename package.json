{
  "name": "hrflow-pro",
  "version": "2.0.0",
  "description": "HRFlow Pro - Comprehensive HR Management System",
  "private": true,
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/backend",
    "apps/mobile",
    "apps/web-admin"
  ],
  "scripts": {
    "dev": "bun run dev:backend",
    "build": "bun run build:backend && bun run build:web-admin && bun run typecheck:mobile",
    "test": "bun run test:backend",
    "clean": "rm -rf apps/backend/dist apps/web-admin/dist",
    "docker:up": "docker compose up -d postgres backend",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:build": "docker compose build",
    "docker:restart": "docker compose restart",
    "dev:backend": "bun run --cwd apps/backend dev",
    "dev:web-admin": "bun run --cwd apps/web-admin dev",
    "dev:mobile": "bun run --cwd apps/mobile start",
    "build:backend": "bun run --cwd apps/backend build",
    "build:web-admin": "bun run --cwd apps/web-admin build",
    "test:backend:unit": "bun run --cwd apps/backend test:unit",
    "test:backend": "NODE_ENV=test bun run --cwd apps/backend test",
    "typecheck:mobile": "bunx tsc --noEmit -p apps/mobile/tsconfig.json",
    "db:schema:ensure": "bun run --cwd apps/backend schema:ensure",
    "migrate:up": "bun run build:backend && bun run --cwd apps/backend migrate:deploy",
    "migrate:down": "echo 'Raw SQL startup migrations are forward-only. Restore from backup or add an explicit rollback script for the target change.'",
    "migrate:status": "echo 'Drizzle schema sync is explicit via migrate:up; generated SQL migrations are not enabled yet.'"
  },
  "devDependencies": {
    "turbo": "^1.11.0",
    "typescript": "^5.3.3",
    "prettier": "^3.1.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.11",
    "supertest": "^6.3.3",
    "@types/supertest": "^6.0.2",
    "@playwright/test": "^1.40.1"
  },
  "engines": {
    "bun": ">=1.3.9",
    "node": ">=18.0.0"
  }
}
