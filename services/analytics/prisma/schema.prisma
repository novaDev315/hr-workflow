// Analytics Service Schema
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Report {
  id            String   @id @default(uuid())
  name          String
  description   String?
  category      ReportCategory

  // Report Configuration
  query         String   // SQL or aggregation query
  parameters    Json?    // Report parameters
  filters       Json?    // Available filters

  // Scheduling
  isScheduled   Boolean  @default(false)
  schedule      String?  // Cron expression
  recipients    String[] // Email addresses

  // Access Control
  isPublic      Boolean  @default(false)
  createdBy     String
  allowedRoles  String[] // Roles that can access

  // Metadata
  lastRunAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  executions    ReportExecution[]

  @@map("reports")
  @@schema("analytics")
}

model ReportExecution {
  id          String   @id @default(uuid())
  reportId    String

  // Execution details
  executedBy  String?
  executedAt  DateTime @default(now())

  // Results
  status      ExecutionStatus
  resultUrl   String?  // S3 or file path
  fileFormat  String?  // PDF, XLSX, CSV
  rowCount    Int?

  // Performance
  duration    Int?     // milliseconds
  errorMessage String?

  report      Report   @relation(fields: [reportId], references: [id])

  @@map("report_executions")
  @@schema("analytics")
}

model Dashboard {
  id          String   @id @default(uuid())
  name        String
  description String?

  // Layout
  layout      Json     // Grid layout configuration
  widgets     Json     // Widget configurations

  // Access
  isDefault   Boolean  @default(false)
  isPublic    Boolean  @default(false)
  createdBy   String
  allowedRoles String[]

  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("dashboards")
  @@schema("analytics")
}

// Enums
enum ReportCategory {
  EMPLOYEE
  ATTENDANCE
  LEAVE
  PAYROLL
  RECRUITMENT
  PERFORMANCE
  COMPLIANCE
  CUSTOM
}

enum ExecutionStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}
