// Leave Service Schema
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LeaveType {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  description       String?
  isPaid            Boolean  @default(true)
  requiresApproval  Boolean  @default(true)
  maxDaysPerYear    Int?
  color             String?  // For UI display
  isActive          Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  policies          LeavePolicy[]
  applications      LeaveApplication[]
  balances          LeaveBalance[]

  @@map("leave_types")
  @@schema("leave")
}

model LeavePolicy {
  id                    String   @id @default(uuid())
  leaveTypeId           String
  name                  String
  description           String?

  // Accrual settings
  accrualType           AccrualType @default(MONTHLY)
  accrualRate           Decimal     @db.Decimal(5, 2) // Days per period
  maxAccrual            Int?        // Maximum days that can be accrued

  // Carryover settings
  allowCarryover        Boolean  @default(false)
  maxCarryoverDays      Int?
  carryoverExpiryMonths Int?     // Months after which carried over leave expires

  // Application rules
  minNoticedays         Int      @default(0)
  maxConsecutiveDays    Int?
  requiresDocument      Boolean  @default(false)
  documentAfterDays     Int?     // Require document if leave > X days

  // Eligibility
  minTenureMonths       Int      @default(0)
  applicableToTypes     Json?    // Array of employment types

  effectiveFrom         DateTime
  effectiveTo           DateTime?
  isActive              Boolean  @default(true)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  leaveType             LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@map("leave_policies")
  @@schema("leave")
}

model LeaveBalance {
  id                String   @id @default(uuid())
  employeeId        String
  leaveTypeId       String
  year              Int

  // Balance tracking
  totalEntitlement  Decimal  @db.Decimal(5, 2)
  used              Decimal  @db.Decimal(5, 2) @default(0)
  pending           Decimal  @db.Decimal(5, 2) @default(0)
  available         Decimal  @db.Decimal(5, 2)
  carriedOver       Decimal  @db.Decimal(5, 2) @default(0)

  // Metadata
  lastAccrualDate   DateTime?
  expiryDate        DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  leaveType         LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
  @@schema("leave")
}

model LeaveApplication {
  id                String   @id @default(uuid())
  applicationNumber String   @unique
  employeeId        String
  leaveTypeId       String

  // Leave details
  startDate         DateTime @db.Date
  endDate           DateTime @db.Date
  totalDays         Decimal  @db.Decimal(5, 2)
  halfDayType       HalfDayType?

  // Application info
  reason            String
  emergencyContact  String?
  documentUrl       String?

  status            LeaveApplicationStatus @default(PENDING)

  // Level 1: Supervisor Review
  l1ReviewedBy      String?
  l1ReviewedAt      DateTime?
  l1Status          ApprovalStatus?
  l1Notes           String?

  // Level 2: Department Manager
  l2ApprovedBy      String?
  l2ApprovedAt      DateTime?
  l2Status          ApprovalStatus?
  l2Notes           String?

  // Level 3: HR Verification
  l3VerifiedBy      String?
  l3VerifiedAt      DateTime?
  l3Status          ApprovalStatus?
  l3Notes           String?

  // System tracking
  appliedAt         DateTime @default(now())
  approvedAt        DateTime?
  rejectedAt        DateTime?
  cancelledAt       DateTime?
  cancellationReason String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  leaveType         LeaveType @relation(fields: [leaveTypeId], references: [id])
  approvalHistory   LeaveApprovalHistory[]

  @@map("leave_applications")
  @@schema("leave")
}

model LeaveApprovalHistory {
  id                String   @id @default(uuid())
  applicationId     String
  approvalLevel     Int      // 1, 2, or 3
  approverId        String
  action            String   // APPROVED, REJECTED, REVISION_REQUIRED
  previousStatus    String
  newStatus         String
  notes             String?

  createdAt         DateTime @default(now())

  application       LeaveApplication @relation(fields: [applicationId], references: [id])

  @@map("leave_approval_history")
  @@schema("leave")
}

model LeaveCalendar {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  year        Int
  month       Int
  day         Int

  isWeekend   Boolean  @default(false)
  isHoliday   Boolean  @default(false)
  holidayName String?
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date])
  @@map("leave_calendar")
  @@schema("leave")
}

model LeaveEncashment {
  id              String   @id @default(uuid())
  employeeId      String
  leaveTypeId     String
  year            Int

  daysEncashed    Decimal  @db.Decimal(5, 2)
  ratePerDay      Decimal  @db.Decimal(15, 2)
  totalAmount     Decimal  @db.Decimal(15, 2)

  status          EncashmentStatus @default(PENDING)

  requestedAt     DateTime @default(now())
  approvedAt      DateTime?
  approvedBy      String?
  processedAt     DateTime?

  payrollPeriod   String?  // Link to payroll period

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("leave_encashments")
  @@schema("leave")
}

// Enums
enum AccrualType {
  MONTHLY
  QUARTERLY
  YEARLY
  ON_JOINING
  ANNIVERSARY
}

enum HalfDayType {
  FIRST_HALF
  SECOND_HALF
}

enum LeaveApplicationStatus {
  PENDING
  PENDING_L1
  PENDING_L2
  PENDING_L3
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAWN
}

enum ApprovalStatus {
  APPROVED
  REJECTED
  REVISION_REQUIRED
}

enum EncashmentStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}
