// Location Service Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Clients
model Client {
  id          String    @id @default(uuid())
  clientCode  String    @unique
  companyName String
  industry    String?
  contactPerson String?
  contactEmail  String?
  contactPhone  String?
  address     String?
  city        String?
  state       String?
  country     String    @default("India")
  postalCode  String?
  website     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contracts   ClientContract[]
  locations   ClientLocation[]

  @@map("clients")
  @@schema("location")
}

// Client Contracts
model ClientContract {
  id          String    @id @default(uuid())
  clientId    String
  contractNumber String @unique
  startDate   DateTime
  endDate     DateTime

  contractValue       Decimal @db.Decimal(15, 2)
  currency            String  @default("USD")

  // Personnel Requirements
  requiredPersonnel   Int
  genderRequirement   GenderRequirement @default(NO_PREFERENCE)
  maleCount           Int?
  femaleCount         Int?

  // Location Information
  numberOfLocations   Int     @default(1)

  // Contract Terms
  paymentTerms        String?
  slaTerms            String?
  autoRenew           Boolean @default(false)
  status              ContractStatus @default(DRAFT)

  signedDocumentUrl   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client      Client    @relation(fields: [clientId], references: [id])
  locations   ClientLocation[]

  @@map("client_contracts")
  @@schema("location")
}

// Client Locations with GPS
model ClientLocation {
  id          String    @id @default(uuid())
  clientId    String
  contractId  String?
  locationCode String
  locationName String

  // GPS Coordinates
  latitude    Decimal   @db.Decimal(10, 8)
  longitude   Decimal   @db.Decimal(11, 8)
  geofenceRadius Int    @default(100) // meters

  // Address
  address     String
  city        String?
  state       String?
  postalCode  String?
  landmark    String?

  // Location Details
  locationType String?
  contactPerson String?
  contactPhone  String?

  // Working Hours
  defaultShiftStart Time @default("09:00:00")
  defaultShiftEnd   Time @default("18:00:00")

  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client      Client    @relation(fields: [clientId], references: [id])
  contract    ClientContract? @relation(fields: [contractId], references: [id])
  assignments EmployeeLocationAssignment[]

  @@unique([clientId, locationCode])
  @@map("client_locations")
  @@schema("location")
}

// Employee Location Assignments (Multi-location support)
model EmployeeLocationAssignment {
  id          String    @id @default(uuid())
  employeeId  String    // Reference to Employee Service
  locationId  String

  isPrimary   Boolean   @default(false)
  assignedDate DateTime @default(now())
  releaseDate  DateTime?

  status      AssignmentStatus @default(ACTIVE)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  location    ClientLocation @relation(fields: [locationId], references: [id])

  @@map("employee_location_assignments")
  @@schema("location")
  @@index([employeeId])
  @@index([locationId])
  @@index([status])
}

// Enums
enum GenderRequirement {
  MALE_ONLY
  FEMALE_ONLY
  MIXED
  NO_PREFERENCE
}

enum ContractStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  TERMINATED
  RENEWED
}

enum AssignmentStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
  TERMINATED
}
