FROM node:18-alpine

WORKDIR /app

# Install canvas dependencies for PDF generation
RUN apk add --no-cache \
    cairo \
    pango \
    jpeg \
    giflib \
    librsvg

# Install dependencies
COPY package*.json ./
RUN npm install

# Copy source
COPY . .

# Generate Prisma Client
RUN npx prisma generate

EXPOSE 3005

CMD ["npm", "run", "dev"]
