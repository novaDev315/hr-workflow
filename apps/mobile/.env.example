# GraphQL endpoint for the app. If unset: http://localhost:4001/graphql in
# development builds, https://api.hrflow.lab.novadev.tech/graphql in release builds.
# On an Android emulator use http://10.0.2.2:4001/graphql; on a phone use your
# computer's LAN address.
EXPO_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:4001/graphql
