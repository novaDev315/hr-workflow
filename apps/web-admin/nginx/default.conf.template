# Rendered by the nginx image's envsubst template step (/etc/nginx/templates).
# Only environment variables that are set are substituted, so nginx $variables
# below are left untouched. API_UPSTREAM_HOST defaults in the Dockerfile.
server {
  listen 8080;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  location = /health {
    access_log off;
    default_type text/plain;
    return 200 'ok';
  }

  location /graphql {
    client_max_body_size 15m;
    include /etc/nginx/conf.d/security-headers.inc;

    proxy_pass https://${API_UPSTREAM_HOST}/graphql;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_ssl_verify_depth 4;
    proxy_set_header Host ${API_UPSTREAM_HOST};
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
  }

  # Hashed build assets: immutable. Missing files must 404, not fall back to index.html.
  location /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
    include /etc/nginx/conf.d/security-headers.inc;
  }

  location = /index.html {
    add_header Cache-Control "no-cache";
    include /etc/nginx/conf.d/security-headers.inc;
  }

  location / {
    include /etc/nginx/conf.d/security-headers.inc;
    try_files $uri $uri/ /index.html;
  }
}
