# Runtime
NODE_ENV=development
APP_NAME=HRFlow Pro
APP_VERSION=2.0.0

# Backend
BACKEND_PORT=4001
BACKEND_PUBLIC_URL=http://localhost:4001
# REQUIRED: 32+ random characters (e.g. `openssl rand -base64 48`). docker compose refuses to start without it.
JWT_SECRET=
JWT_EXPIRY=3600s
# Comma-separated browser origins allowed by CORS. REQUIRED in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006
# Set to the number of reverse proxies in front of the API (e.g. 1) so client IPs are read correctly.
TRUST_PROXY=
# First admin seeding: when both are set, the first admin user is created on startup/migrate:deploy.
HR_WORKFLOW_ADMIN_EMAIL=
HR_WORKFLOW_ADMIN_PASSWORD=
# Production only: allow the first-run UI bootstrap. Default off; leave unset unless you need it.
BOOTSTRAP_ALLOWED=
POLICY_STORAGE_DIR=./storage/policies

# PostgreSQL
POSTGRES_DB=hrflow_dev
POSTGRES_USER=hrflow_admin
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://hrflow_admin:change_me@localhost:5432/hrflow_dev
# Local web-admin dev proxy target for /graphql (defaults to http://localhost:4001)
# VITE_DEV_API_PROXY=http://localhost:4001

# Frontend endpoints
VITE_GRAPHQL_ENDPOINT=http://localhost:4001/graphql
EXPO_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:4001/graphql
