# Application
NODE_ENV=development
APP_NAME=HRFlow Pro
APP_VERSION=2.0.0

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hrflow_dev
POSTGRES_USER=hrflow_admin
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_MAX_CONNECTIONS=200

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_production

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=hrflow
RABBITMQ_PASSWORD=change_me_in_production

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=hrflow_access_key
MINIO_SECRET_KEY=change_me_in_production
MINIO_BUCKET=hrflow-files

# JWT Authentication
JWT_SECRET=change_me_to_random_256_bit_secret
JWT_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=604800

# GPS Geofencing
GEOFENCE_DEFAULT_RADIUS=100

# Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=hrflow@example.com
SMTP_PASSWORD=change_me_in_production

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=admin

# API Gateway
API_GATEWAY_PORT=4000
API_GATEWAY_HOST=0.0.0.0

# Services Ports (Internal)
EMPLOYEE_SERVICE_PORT=3001
ATTENDANCE_SERVICE_PORT=3002
LEAVE_SERVICE_PORT=3003
LOCATION_SERVICE_PORT=3004
PAYROLL_SERVICE_PORT=3005
