# Runtime
NODE_ENV=development
APP_NAME=HRFlow Pro
APP_VERSION=2.0.0

# Backend
BACKEND_PORT=4001
JWT_SECRET=change_me_to_random_256_bit_secret
JWT_EXPIRY=3600s
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# PostgreSQL
POSTGRES_DB=hrflow_dev
POSTGRES_USER=hrflow_admin
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://hrflow_admin:change_me@localhost:5432/hrflow_dev

# Frontend endpoints
VITE_GRAPHQL_ENDPOINT=http://localhost:4001/graphql
EXPO_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:4001/graphql
