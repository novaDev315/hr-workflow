NODE_ENV=production
BACKEND_PORT=4001
BACKEND_PUBLIC_URL=https://api.hrflow.lab.novadev.tech
# REQUIRED: 32+ random characters (e.g. `openssl rand -base64 48`).
JWT_SECRET=replace_with_32_plus_random_characters
JWT_EXPIRY=3600s
# REQUIRED in production: comma-separated allowed browser origins.
ALLOWED_ORIGINS=https://admin.hrflow.lab.novadev.tech
# Number of reverse proxies in front of the API (Traefik -> 1).
TRUST_PROXY=1
VITE_GRAPHQL_ENDPOINT=/graphql
POLICY_STORAGE_DIR=/var/lib/hrflow/policies

# First admin seeding (created when both are set and no admin exists yet).
RAKSS_ADMIN_EMAIL=admin@hrflow.lab.novadev.tech
RAKSS_ADMIN_PASSWORD=replace_with_a_strong_password
# First-run UI bootstrap in production. Default off; enable only for the first run.
BOOTSTRAP_ALLOWED=false

# Filled by: homelab apps database create rakss --service backend --db-type postgres --mode central --env-file .env.production
DATABASE_URL=postgresql://rakss_backend:replace_me@10.0.40.10:5432/rakss_backend_production
